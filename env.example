# Copy this file, fill in the values, and point the desk at the copy.
# Never commit the filled-in file.
#
#   cp env.example my-polymarket.env
#   export POLY_ENV="$PWD/my-polymarket.env"
#
# Get these from Polymarket US → Settings → API keys.
# POLYMARKET_SECRET_KEY is the secret, not a public key.

POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=
