# Copy this file, fill in the values, and point the desk at the copy.
# Never commit the filled-in file.
#
#   cp env.example my-polymarket.env
#   export POLY_ENV="$PWD/my-polymarket.env"
#
# How to create keys (Polymarket US, not polymarket.com):
#   https://docs.polymarket.us/getting-started/quickstart
#   https://polymarket.us/developer
# POLYMARKET_SECRET_KEY is shown once. It is the secret, not a public key.

POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=
